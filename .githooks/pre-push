#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
temporary_root=$(mktemp -d "${TMPDIR:-/tmp}/gwprov-push-gate.XXXXXX")
rmdir "$temporary_root"
cleanup() {
	git -C "$repo_root" worktree remove --force "$temporary_root" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$local_sha" ] || continue
	case "$local_sha" in
		0000000000000000000000000000000000000000) continue ;;
	esac
	printf 'Running CI push gate for %s (%s).\n' "$local_ref" "$local_sha"
	git -C "$repo_root" worktree add --quiet --detach "$temporary_root" "$local_sha"
	(
		cd "$temporary_root"
		make ci
	)
	git -C "$repo_root" worktree remove --force "$temporary_root"
done
